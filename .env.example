# Copy this file to .env.local to override defaults per environment.

# WhatsApp Business number, digits only, country code first, no "+" or spaces.
# The live number (+91 81226 64470) is already the default in
# src/lib/config.ts — only set this if you need a different number for a
# staging/test environment.
VITE_WHATSAPP_NUMBER=918122664470

# Optional: URL that receives every captured lead as a JSON POST (Google Apps
# Script web app, Zapier/Make webhook, CRM inbox, etc). Leave blank for MVP —
# leads still land safely on WhatsApp and in the browser's local lead history.
VITE_LEAD_WEBHOOK_URL=

# Base URL of the server/ backend (see server/README.md), e.g.
# http://localhost:3001 locally or https://api.magicalrealm.example.com in
# production. Leave blank to run frontend-only — leads still persist to
# localStorage, they just won't reach the SQLite database.
VITE_API_BASE_URL=
