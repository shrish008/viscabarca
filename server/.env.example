# Copy to .env (or set these in your process manager / hosting provider).

PORT=3001

# Comma-separated list of allowed origins for the frontend, e.g.
# https://magicalrealm.example.com. Defaults to "*" (any origin) for local
# development — lock this down before deploying.
CORS_ORIGIN=*

# Required to read GET /api/leads (pass as the x-api-key header). Leave
# unset only for local development — without it, the leads list is public.
ADMIN_API_KEY=
